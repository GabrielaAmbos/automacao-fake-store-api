#!/bin/sh
#
# Runs lint and the API suite before every push.
#
# CI cannot do this: the Fake Store API answers 403 to GitHub-hosted runners, so
# pull requests only run lint. Without this hook nothing would catch a broken
# test before it reaches main — a green PR does not mean the tests passed.
#
# Installed automatically by the `prepare` npm script, which points
# core.hooksPath at this directory.
#
# To skip it deliberately (docs-only pushes, work in progress):
#   git push --no-verify

ZERO_SHA="0000000000000000000000000000000000000000"

# Branch deletions (`git push --delete`) arrive here with an all-zero local sha
# and nothing to test. Skip them instead of running the suite for nothing.
has_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [ "$local_sha" != "$ZERO_SHA" ]; then
        has_commits=1
    fi
done

if [ "$has_commits" -eq 0 ]; then
    exit 0
fi

# The VS Code integrated terminal exports ELECTRON_RUN_AS_NODE=1, which makes the
# Cypress binary start as plain Node and die on `bad option: --no-sandbox`.
# Clearing it here keeps the hook from failing for the wrong reason.
unset ELECTRON_RUN_AS_NODE

echo "pre-push: running lint..."
if ! npm run lint --silent; then
    echo ""
    echo "pre-push: lint failed. Fix it, or push with --no-verify."
    exit 1
fi

echo "pre-push: running the API suite (CI cannot run it — see docs/running-and-ci.md)..."
if ! npm test --silent; then
    echo ""
    echo "pre-push: tests failed. Push blocked."
    echo "  If the failures are 403s, your network is being blocked by the API."
    echo "  If you are pushing docs only, use: git push --no-verify"
    exit 1
fi

echo "pre-push: lint and 40 tests passed."
exit 0
